<?xml version="1.0"?>
<!-- One wheel-leg: base -> hip (x) -> thigh (y) -> calf (y) -> wheel (continuous, y). Lengths 0.2 / 0.2, r = 0.05. -->
<robot name="toy">
  <link name="base">
    <inertial><origin xyz="0 0 0"/><mass value="2.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <collision><geometry><box size="0.3 0.2 0.1"/></geometry></collision>
  </link>
  <link name="hip"><inertial><mass value="0.5"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial></link>
  <link name="thigh"><inertial><origin xyz="0 0 -0.1"/><mass value="0.5"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial></link>
  <link name="calf"><inertial><origin xyz="0 0 -0.1"/><mass value="0.3"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial></link>
  <link name="calf_guard"><collision><geometry><sphere radius="0.01"/></geometry></collision></link>
  <link name="wheel">
    <inertial><mass value="0.2"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    <collision><origin xyz="0 0.02 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></collision>
  </link>
  <joint name="hip_joint" type="revolute">
    <parent link="base"/><child link="hip"/><origin xyz="0.1 0.05 0"/><axis xyz="1 0 0"/>
    <limit lower="-1" upper="1" effort="10" velocity="20"/>
  </joint>
  <joint name="thigh_joint" type="revolute">
    <parent link="hip"/><child link="thigh"/><origin xyz="0 0.05 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="3" effort="10" velocity="20"/>
  </joint>
  <joint name="calf_joint" type="revolute">
    <parent link="thigh"/><child link="calf"/><origin xyz="0 0 -0.2"/><axis xyz="0 1 0"/>
    <limit lower="-2.7" upper="-0.8" effort="15" velocity="15"/>
  </joint>
  <joint name="guard_joint" type="fixed"><parent link="calf"/><child link="calf_guard"/><origin xyz="0 0 -0.1"/></joint>
  <joint name="wheel_joint" type="continuous">
    <parent link="calf"/><child link="wheel"/><origin xyz="0 0 -0.2"/><axis xyz="0 1 0"/>
    <limit effort="5" velocity="30"/>
  </joint>
</robot>
